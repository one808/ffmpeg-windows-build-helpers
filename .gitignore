# Build sandbox: downloaded sources, cross-toolchain, build artifacts.
# This is 40-60+ GB and must never be committed.
ffmpeg_local_builds/sandbox/
redist/

# Real Windows system DLLs used as a ground-truth reference by
# scripts/check-xp-compat.sh --xp-system32=. Microsoft copyrighted
# binaries -- never commit these, regardless of where you put them.
ffmpeg_local_builds/xp-reference-dlls/

# Container build context leftovers.
*.tar

# Build logs from scripts/build.sh.
logs/


# Generated wget wrapper (bypasses savannah 502).
bin/

# Pre-fetched config.guess fallback.
patches/config.guess
