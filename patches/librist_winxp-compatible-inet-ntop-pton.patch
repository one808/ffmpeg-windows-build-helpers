+
+/* Windows XP's ws2_32.dll does not export inet_ntop/inet_pton -- both were added in Vista. mingw-w64's
+ * <ws2tcpip.h> declares them as plain DLL imports regardless (assuming a newer ws2_32.dll), so any code
+ * that calls them creates a static import the real XP ws2_32.dll can't satisfy, which blocks the whole
+ * .exe from loading -- not just the RIST/IPv6 code path that uses them. Provide our own implementations
+ * for MinGW builds instead of relying on the OS to have them. */
+#ifndef LIBRIST_XP_INET_COMPAT_H
+#define LIBRIST_XP_INET_COMPAT_H
+
+#if defined(_WIN32) && defined(__MINGW32__)
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <stdio.h>
+#include <string.h>
+
+static inline const char *rist_xp_inet_ntop(int af, const void *src, char *dst, size_t size) {
+	if (af == AF_INET) {
+		const unsigned char *b = (const unsigned char *)src;
+		if (snprintf(dst, size, "%u.%u.%u.%u", b[0], b[1], b[2], b[3]) >= (int)size)
+			return NULL;
+		return dst;
+	} else if (af == AF_INET6) {
+		const unsigned char *b = (const unsigned char *)src;
+		unsigned int words[8];
+		int i;
+		for (i = 0; i < 8; i++)
+			words[i] = ((unsigned int)b[i * 2] << 8) | b[i * 2 + 1];
+
+		/* RFC 5952: find the longest run of zero groups (length >= 2) to compress with "::". */
+		int best_base = -1, best_len = 0, cur_base = -1, cur_len = 0;
+		for (i = 0; i < 8; i++) {
+			if (words[i] == 0) {
+				if (cur_base == -1) cur_base = i;
+				cur_len++;
+				if (cur_len > best_len) { best_base = cur_base; best_len = cur_len; }
+			} else {
+				cur_base = -1;
+				cur_len = 0;
+			}
+		}
+		if (best_len < 2) best_base = -1;
+
+		char *p = dst;
+		char *end = dst + size;
+		int wrote_colon = 0;
+		for (i = 0; i < 8; i++) {
+			if (best_base != -1 && i >= best_base && i < best_base + best_len) {
+				if (i == best_base) {
+					if (p >= end - 1) return NULL;
+					*p++ = ':';
+				}
+				continue;
+			}
+			if (i > 0 && !(i == best_base + best_len)) {
+				if (p >= end - 1) return NULL;
+				*p++ = ':';
+			} else if (i == best_base + best_len && best_base != -1) {
+				/* colon already written by the "::" collapse above */
+			}
+			int n = snprintf(p, end - p, "%x", words[i]);
+			if (n < 0 || p + n >= end) return NULL;
+			p += n;
+			wrote_colon = 0;
+			(void)wrote_colon;
+		}
+		if (best_base == 0 && best_len > 0 && p == dst + 1) {
+			/* address was all-zero apart from nothing after the leading "::" -- append a second colon */
+			if (p >= end - 1) return NULL;
+			*p++ = ':';
+		}
+		if (p >= end) return NULL;
+		*p = '\0';
+		return dst;
+	}
+	return NULL;
+}
+
+static inline int rist_xp_inet_pton(int af, const char *src, void *dst) {
+	if (af == AF_INET) {
+		unsigned int b[4];
+		int n = 0, consumed = 0;
+		if (sscanf(src, "%u.%u.%u.%u%n", &b[0], &b[1], &b[2], &b[3], &consumed) != 4)
+			return 0;
+		if (src[consumed] != '\0') return 0; /* trailing garbage */
+		for (n = 0; n < 4; n++) if (b[n] > 255) return 0;
+		unsigned char *out = (unsigned char *)dst;
+		out[0] = (unsigned char)b[0]; out[1] = (unsigned char)b[1];
+		out[2] = (unsigned char)b[2]; out[3] = (unsigned char)b[3];
+		return 1;
+	} else if (af == AF_INET6) {
+		/* Split on "::" (at most one occurrence), then parse each side's colon-separated hex groups.
+		 * Supports a trailing embedded IPv4 literal (e.g. "::ffff:1.2.3.4"). */
+		const char *dbl = strstr(src, "::");
+		const char *left_end = dbl ? dbl : src + strlen(src);
+		const char *right_start = dbl ? dbl + 2 : NULL;
+
+		unsigned int left[8]; int left_n = 0;
+		unsigned int right[8]; int right_n = 0;
+
+		const char *p = src;
+		while (p < left_end && left_n < 8) {
+			char *endp;
+			/* Embedded IPv4 tail on the left side (only valid as the very last left group). */
+			if (strchr(p, '.') && strchr(p, '.') < left_end) {
+				unsigned int b[4];
+				if (sscanf(p, "%u.%u.%u.%u", &b[0], &b[1], &b[2], &b[3]) != 4) return 0;
+				for (int k = 0; k < 4; k++) if (b[k] > 255) return 0;
+				left[left_n++] = (b[0] << 8) | b[1];
+				left[left_n++] = (b[2] << 8) | b[3];
+				break;
+			}
+			unsigned long v = strtoul(p, &endp, 16);
+			if (endp == p || v > 0xffff) return 0;
+			left[left_n++] = (unsigned int)v;
+			p = endp;
+			if (p < left_end) {
+				if (*p != ':') return 0;
+				p++;
+			}
+		}
+		if (!dbl && left_n != 8) return 0;
+
+		if (dbl) {
+			p = right_start;
+			const char *send = src + strlen(src);
+			while (p < send && right_n < 8) {
+				char *endp;
+				if (strchr(p, '.') && strchr(p, '.') < send) {
+					unsigned int b[4];
+					if (sscanf(p, "%u.%u.%u.%u", &b[0], &b[1], &b[2], &b[3]) != 4) return 0;
+					for (int k = 0; k < 4; k++) if (b[k] > 255) return 0;
+					right[right_n++] = (b[0] << 8) | b[1];
+					right[right_n++] = (b[2] << 8) | b[3];
+					break;
+				}
+				if (*p == '\0') break;
+				unsigned long v = strtoul(p, &endp, 16);
+				if (endp == p || v > 0xffff) return 0;
+				right[right_n++] = (unsigned int)v;
+				p = endp;
+				if (p < send) {
+					if (*p != ':') return 0;
+					p++;
+				}
+			}
+			if (left_n + right_n > 8) return 0;
+		}
+
+		unsigned int words[8] = {0};
+		for (int k = 0; k < left_n; k++) words[k] = left[k];
+		for (int k = 0; k < right_n; k++) words[8 - right_n + k] = right[k];
+
+		unsigned char *out = (unsigned char *)dst;
+		for (int k = 0; k < 8; k++) {
+			out[k * 2] = (unsigned char)(words[k] >> 8);
+			out[k * 2 + 1] = (unsigned char)(words[k] & 0xff);
+		}
+		return 1;
+	}
+	return 0;
+}
+
+#define inet_ntop(af, src, dst, size) rist_xp_inet_ntop((af), (src), (dst), (size))
+#define inet_pton(af, src, dst) rist_xp_inet_pton((af), (src), (dst))
+
+#endif /* _WIN32 && __MINGW32__ */
+
+#endif /* LIBRIST_XP_INET_COMPAT_H */
